{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/jobs/noop", "schedule": "0 6 * * *" },
    { "path": "/api/jobs/refresh-region-counts", "schedule": "15 6 * * *" }
  ],
  "functions": {
    "src/app/api/queues/jobs/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "jobs", "retryAfterSeconds": 10, "maxDeliveries": 8 }
      ]
    }
  }
}
