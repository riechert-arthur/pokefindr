{
  "name": "pokefindr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit",
    "job": "tsx --conditions=react-server scripts/run-job.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/db/migrate.ts up",
    "db:rollback": "tsx scripts/db/migrate.ts down",
    "db:status": "tsx scripts/db/migrate.ts status",
    "db:check": "tsx scripts/db/check.ts",
    "db:baseline": "tsx scripts/db/baseline.ts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:import-locations": "tsx scripts/one-off/import-locations.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.3.1",
