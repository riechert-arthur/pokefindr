    "react-dom": "^19.0.0",
    "react-hook-form": "^7.56.3",
    "react-map-gl": "^7.1.9",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "remark-slug": "^7.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.6.1",
