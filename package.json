{
  "name": "pokefindr",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prelint": "npm run i18n:build",
    "lint": "next lint",
    "test": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "pretypecheck": "npm run i18n:build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "job": "tsx --conditions=react-server scripts/run-job.ts",
    "assistant:feedback": "tsx --conditions=react-server scripts/assistant/feedback.ts",
    "eval:assistant": "tsx --conditions=react-server scripts/assistant/eval.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/db/migrate.ts up",
    "db:rollback": "tsx scripts/db/migrate.ts down",
    "db:status": "tsx scripts/db/migrate.ts status",
    "db:check": "tsx scripts/db/check.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:baseline": "tsx scripts/db/baseline.ts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "db:import-locations": "tsx scripts/one-off/import-locations.ts",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006",
    "test-storybook:local": "bash scripts/test-storybook-local.sh",
    "test:e2e": "playwright test",
    "i18n:build": "node scripts/i18n/build.mjs",
    "postinstall": "node scripts/i18n/build.mjs"
  },
