{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 4318",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4318/",
        "http://localhost:4318/map",
        "http://localhost:4318/map?location=00000000-0000-4000-8000-000000000000",
        "http://localhost:4318/blog",
        "http://localhost:4318/blog/what-are-pokemon-card-vending-machines",
        "http://localhost:4318/privacy-policy",
        "http://localhost:4318/changelog",
        "http://localhost:4318/es"
      ],
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:seo": ["warn", { "minScore": 1 }],
            "categories:accessibility": ["warn", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.95 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4318/(es)?$",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
          }
        },
        {
          "matchingUrlPattern": "/map",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.7 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 600 }]
          }
        },
        {
          "matchingUrlPattern": "/(blog|privacy-policy|changelog)",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.95 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
