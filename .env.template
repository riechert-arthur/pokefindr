# Database (Postgres 15+ with PostGIS). Local: `make run`
DATABASE_URL=postgres://pokefindr:pokefindr@localhost:5433/pokefindr
# Direct (non-pooled) URL for migrations; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=

# Auth (required; validated at start-up by src/server/config.ts). Accounts live in our own
# database (Better Auth, docs/auth.md); no outside service is needed.
# Use a long random value, e.g. `openssl rand -base64 48`
JWT_SECRET=
APP_URL=http://localhost:3000
# Optional: Better Auth's own secret (32+ characters). Unset, it's derived from JWT_SECRET.
BETTER_AUTH_SECRET=
# Optional: "Continue with Google / Discord", each shown when its id and secret are set.
# Register ${APP_URL}/api/identity/callback/google (or /discord) as the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Email (src/server/container.ts). "console" (the default) prints each email to the server log;
# it refuses to run in production. "smtp" sends through SMTP_URL, e.g. smtps://user:pass@smtp.example.com:465.
# `make run` sends to Mailpit (http://localhost:8025) whatever this says.
MAIL_PROVIDER=
SMTP_URL=
# The From address; its domain needs SPF and DKIM records with the SMTP provider
MAIL_FROM=

# Background jobs (/api/jobs/<name>). Optional; without it every job request is rejected.
# At least 16 characters (use `openssl rand -base64 48`). Vercel Cron sends it; it also signs queue messages.
CRON_SECRET=

# Geocoding on the server (src/server/container.ts): fake, photon, mapbox, maptiler or nominatim.
# Unset: photon in production, fake (no account, a handful of cities) everywhere else.
GEOCODER_PROVIDER=
# Where API rate limits keep their buckets: postgres (shared by every instance) or memory. Postgres in production, memory otherwise.
RATE_LIMIT_STORE=
# Required for mapbox and maptiler
GEOCODER_API_KEY=
# Required for nominatim, e.g. "PokeFindr (support@pokefindr.com)"
GEOCODER_USER_AGENT=
# Optional: a self-hosted instance instead of the public one
GEOCODER_BASE_URL=

# Assistant (/api/assistant). Without a key (or federation below) the assistant says it's unavailable.
ANTHROPIC_API_KEY=
# Optional, instead of a key on Vercel and in CI: workload identity federation (#226). Not secrets.
# The rule decides which project and environment may get tokens, for which workspace.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
# Optional: the model (default claude-opus-5-5) and effort (low, medium, high, xhigh, max; default medium)
ASSISTANT_MODEL=
ASSISTANT_EFFORT=
# Optional: "false" pauses the assistant; the daily spend ceiling over all users in dollars (default 10)
ASSISTANT_ENABLED=
ASSISTANT_DAILY_BUDGET_USD=

# Affiliate banner
# Analytics (#53): none (default; local dev and CI send nothing) | vercel | plausible | umami.
# Production on Vercel: set it to vercel to keep Vercel Analytics.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Plausible: the site's domain (pokefindr.app). Umami: the website id.
NEXT_PUBLIC_ANALYTICS_SITE=
# Self-hosted Plausible or Umami: the tracker script's URL.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
# The first sponsored banner's link and pixel (src/config/banners.ts). New banners go in that file.
NEXT_PUBLIC_PIXEL_TRACKING_URL_1=
NEXT_PUBLIC_AFFILIATE_LINK_1=

# Script-only variables (the Python location scripts, #51)
SUPABASE_URL=
SUPABASE_KEY=
GEOJSON_PATH=
MAPBOX_API_KEY=
